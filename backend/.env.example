# ==========================================
# VyaparIQ Backend Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Replace with local MongoDB URI or MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/vyapariq

# Clerk Authentication (Get these from your Clerk Dashboard: https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Frontend URL (For CORS configuration with Vite frontend)
FRONTEND_URL=http://localhost:5173

# Google Gemini AI Configuration (Get your API key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
