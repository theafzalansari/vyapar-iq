# ==========================================
# VyaparIQ Frontend Configuration
# ==========================================

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:5000/api

# Clerk Publishable Key (Only the client-safe public key starting with pk_test_)
# Leave blank to automatically use Mock Developer Auth mode (no account required)
VITE_CLERK_PUBLISHABLE_KEY=

# Set to 'true' to develop entirely with offline mock data, or 'false' to call the backend API
VITE_USE_MOCK_DATA=true
